            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSessionResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "会话管理"
        ],
        "summary": "归档会话",
        "description": "将指定会话标记为已归档，不再显示在列表中",
        "operationId": "archiveSession",
        "parameters": [
          {
            "name": "sessionId",
