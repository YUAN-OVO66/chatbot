  "components": {
    "schemas": {
      "ResultVoid": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应提示信息",
            "example": "操作成功"
          },
          "data": {
            "type": "object",
            "description": "响应数据"
          }
        }
      },
      "PreferenceRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "preferenceKey": {
            "type": "string"
          },
          "preferenceValue": {
            "type": "string"
          }
        }
      },
      "ResultUserPreference": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应提示信息",
            "example": "操作成功"
          },
          "data": {
            "$ref": "#/components/schemas/UserPreference",
            "description": "响应数据"
          }
        }
      },
      "UserPreference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "string"
          },
          "preferenceKey": {
            "type": "string"
          },
          "preferenceValue": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResultString": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应提示信息",
            "example": "操作成功"
          },
          "data": {
            "type": "string",
            "description": "响应数据"
          }
        }
      },
      "SessionCreateRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      },
      "ResultSessionResponse": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应提示信息",
            "example": "操作成功"
          },
          "data": {
            "$ref": "#/components/schemas/SessionResponse",
            "description": "响应数据"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "RagDocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fileType": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResultRagDocumentResponse": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "状态码，200表示成功",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "响应提示信息",
            "example": "操作成功"
          },
          "data": {
            "$ref": "#/components/schemas/RagDocumentResponse",
            "description": "响应数据"
