      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "refType": null
          },
          "reply": {
            "type": "string",
            "refType": null
          },
          "retrievedMemoryFacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "refType": "string"
          }
        }
      },
      "ResultChatResponse": {
        "type": "object",
        "description": "统一响应结果",
        "properties": {
          "code": {
            "type": "integer",
