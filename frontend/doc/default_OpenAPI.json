{
  "openapi": "3.1.0",
  "info": {
    "title": "Chatbot Long-Term Memory API",
    "description": "聊天机器人长期记忆模块接口文档，包含聊天、会话管理、记忆管理等接口",
    "contact": {
      "name": "iflytek",
      "email": "dev@iflytek.com"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "聊天接口",
      "description": "发送消息、多轮对话"
    },
    {
      "name": "RAG 知识库",
      "description": "上传、查看、删除知识库文档"
    },
    {
      "name": "记忆管理",
      "description": "查看、删除长期记忆事实，管理用户偏好"
    },
    {
      "name": "会话管理",
      "description": "创建、查询、归档会话"
    },
    {
      "name": "插件管理",
      "description": "查看和管理确定性插件"
    },
    {
      "name": "技能管理",
      "description": "查看和管理 LLM 可用的技能"
    }
  ],
  "paths": {
    "/api/plugins/{name}/enable": {
      "put": {
        "tags": [
          "插件管理"
        ],
        "summary": "启用插件",
        "operationId": "enablePlugin",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "插件名称",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/plugins/{name}/disable": {
      "put": {
        "tags": [
          "插件管理"
        ],
        "summary": "禁用插件",
        "operationId": "disablePlugin",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "插件名称",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/memory/preferences": {
      "get": {
        "tags": [
          "记忆管理"
        ],
        "summary": "偏好列表",
        "description": "获取指定用户的所有偏好设置，按置信度降序排列",
        "operationId": "listPreferences",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultListUserPreference"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "记忆管理"
        ],
        "summary": "设置偏好",
        "description": "手动设置或更新用户偏好，来源标记为explicit，置信度为1.0",
        "operationId": "setPreference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultUserPreference"
                }
              }
            }
          }
        }
      }
    },
    "/api/skills/reload": {
      "post": {
        "tags": [
          "技能管理"
        ],
        "summary": "重新加载技能",
        "operationId": "reload",
