    "/api/sessions/{sessionId}": {
      "get": {
        "tags": [
          "会话管理"
        ],
        "summary": "会话详情",
        "description": "根据会话ID获取会话详细信息",
        "operationId": "getSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
